# Copy this file to .env.local and fill in your Supabase project's values.
# Find these under Project Settings → API in the Supabase dashboard.
# Both values here are safe to expose to the browser — RLS policies in
# supabase/migrations/ do the actual access control, not these keys.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
